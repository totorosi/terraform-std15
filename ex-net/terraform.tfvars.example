# 이 파일을 terraform.tfvars 로 복사해서 값을 채우세요.
# terraform.tfvars 는 .gitignore 로 제외되고, 이 example 파일만 커밋됩니다.
#   cp terraform.tfvars.example terraform.tfvars

# SSH 를 허용할 IP. 비워 두면 22번 포트가 아예 열리지 않습니다.
admin_cidr_blocks = ["203.0.113.10/32"]

# 필요할 때만 주석을 해제해서 기본값을 덮어씁니다.
