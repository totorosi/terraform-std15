# === 1. 보안 및 환경 변수 (최우선 제외) ===
# gitignore 는 줄 끝 주석(패턴 뒤 # ...)을 지원하지 않는다.
# 예전에는 ".env    # 설명" 형태여서 패턴 전체가 리터럴로 취급되어
# .env / .claude/ 등이 실제로 무시되지 않았다. 주석은 항상 별도 줄에 적는다.

# API 키, DB 비밀번호 등 민감 정보
.env
.env.*

# AWS 접속용 키 페어와 암호화 키 파일
*.pem
*.key

# === 2. Python 가상 환경 및 패키지 ===
# 가상 환경 폴더
venv/
.venv/
env/
bin/
lib/
include/

# === 3. Python 캐시 및 컴파일 파일 ===
# 런타임 시 생성되는 바이트코드 캐시
__pycache__/
# .pyc, .pyo, .pyd 파일
*.py[cod]
*$py.class

# === 4. 운영체제 및 도구 설정 ===
# macOS 전용 시스템 파일
.DS_Store
# Windows 전용 썸네일 파일
Thumbs.db
# VS Code 개인 설정
.vscode/
# PyCharm 설정 파일
.idea/
# Claude 로컬 권한 및 개인 설정
.claude/

# === 5. 빌드 및 배포 결과물 ===
build/
dist/
*.egg-info/

# === 6. Terraform 보호 파일 및 디렉토리 ===
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
# 편집기/수동 백업 파일 (예: main.tf-, main.tf~)
*.tf-
*.tf~
*.tfbak

# === 기타 ===
.aws/
